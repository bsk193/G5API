# ---------------------------------------------------------------------------
# G5API – Railway environment variables
# ---------------------------------------------------------------------------
# Copy these into your Railway service's "Variables" tab. Values written as
# ${{Service.VAR}} are Railway reference variables – replace "MariaDB" / "Redis"
# with the actual names of your database/cache services in the project.
#
# IMPORTANT: the following values are injected verbatim into a JSON config file
# (config/production.json) at boot. The ones marked (JSON number/bool) must NOT
# be quoted and must be a valid number or true/false, or the app won't start.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Railway sets PORT automatically at runtime – do NOT hard-code it.   (JSON number)
# PORT=3301

# Public base URL of THIS API service (Railway gives you a domain under
# Settings -> Networking). No trailing slash, no /api suffix.
HOSTNAME=https://your-g5api.up.railway.app
APIURL=https://your-g5api.up.railway.app

# Public URL of the G5V front end. Used for CORS + post-login redirect.
CLIENTHOME=https://your-g5v.up.railway.app

# 32-character key used to encrypt stored RCON passwords. Generate once and
# keep it stable, e.g.  openssl rand -hex 16
DBKEY=change_me_32_characters_exactly_

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SHAREDSECRET=change_me_to_a_long_random_string

STEAMAPIKEY=your_steam_web_api_key
# Optional Steam shared secret (leave blank if unused)
# SHAREDSECRET above is the cookie secret; STEAM shared secret is not required.

# ---- MariaDB (Railway database service) ----
SQLUSER=${{MariaDB.MYSQLUSER}}
SQLPASSWORD=${{MariaDB.MYSQLPASSWORD}}
SQLHOST=${{MariaDB.MYSQLHOST}}
SQLPORT=${{MariaDB.MYSQLPORT}}
DATABASE=${{MariaDB.MYSQLDATABASE}}

# ---- Redis (Railway cache service) ----
USEREDIS=true
REDISURL=${{Redis.REDIS_URL}}
REDISTTL=86400
QUEUETTL=3600

# ---- Behaviour flags ----
UPLOADDEMOS=true
LOCALLOGINS=false
SERVERPINGTO=5000
SERVERPROVIDER=local

# ---- Admin / super-admin Steam IDs (comma separated, no spaces) ----
ADMINS=
SUPERADMINS=76561198000000000
